# Copy to .env and replace POSTGRES_PASSWORD before any non-local use.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-at-least-32-random-characters
POSTGRES_DB=store

# Optional: match `id -u` / `id -g` on the host so agentgateway/data is writable.
# AGW_UID=1000
# AGW_GID=1000

# Keycloak eval admin (start-dev). Change before any non-local use.
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
